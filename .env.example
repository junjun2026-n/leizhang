DATABASE_URL=postgresql+psycopg://jump_ssh:SET_LOCALLY_BEFORE_USE@127.0.0.1:5432/jump_ssh
MASTER_KEY=GENERATE_WITH_INIT_CONFIG
PUBLIC_ORIGIN=https://jump.example.com
# Explicit additional origins, comma-separated. Never use wildcard hosts.
ALLOWED_ORIGINS=
COOKIE_SECURE=true
SESSION_MINUTES=480
SSH_SESSION_SECONDS=3600
SSH_IDLE_SECONDS=900
MAX_RECORDING_BYTES=20971520
VNC_BACKEND=native
